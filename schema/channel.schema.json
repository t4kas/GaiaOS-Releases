{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GaiaOS channel feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "release"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "release": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "tag",
            "published_at",
            "source_commit",
            "minimum_updater_version",
            "minimum_base_version",
            "release_notes",
            "assets"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.[1-9][0-9]*)?$"
            },
            "tag": {
              "type": "string"
            },
            "published_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "minimum_updater_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "minimum_base_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "release_notes": {
              "type": "string",
              "minLength": 1
            },
            "assets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "component",
                  "platform",
                  "architecture",
                  "file_name",
                  "url",
                  "size_bytes",
                  "sha256"
                ],
                "properties": {
                  "component": {
                    "const": "launcher"
                  },
                  "platform": {
                    "const": "linux-debian-13"
                  },
                  "architecture": {
                    "const": "x86_64"
                  },
                  "file_name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://github\\.com/t4kas/GaiaOS-Releases/releases/download/v"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "tools/validate_channels.py additionally enforces channel/version, exact tag/asset URL/filename matching and unique targets."
}
